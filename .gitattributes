# Depoda satır sonları LF olarak saklanır; Windows'ta çalışma kopyasında
# CRLF kullanılır. Bu, platformlar arası farkların gürültü yaratmasını önler.
* text=auto eol=lf

# Windows'a özgü scriptler CRLF olmalıdır, aksi hâlde bazı kabuklar
# ve .bat yorumlayıcısı sorun çıkarabilir.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Kaynak ve yapılandırma dosyaları her zaman LF
# (*.sh kritik: CRLF ile giderse macOS runner "bad interpreter ^M" verir)
*.sh    text eol=lf
*.py    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf
Dockerfile     text eol=lf
.env.example   text eol=lf
.gitignore     text eol=lf
.dockerignore  text eol=lf

# İkili dosyalar dönüştürülmez
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.sqlite3 binary
*.xlsx  binary

# GitHub dil istatistiklerinde üçüncü taraf varlıkları sayma
static/vendor/** linguist-vendored
