# ============================================================
#  Akıllı Restaurant Yönetim Sistemi - Ortam Değişkenleri Örneği
# ------------------------------------------------------------
#  Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.
#      Copy-Item .env.example .env
#
#  UYARI: ".env" dosyası .gitignore içindedir ve ASLA depoya
#  gönderilmemelidir. Gerçek API anahtarlarınızı yalnızca
#  ".env" içinde tutun.
#
#  BU DOSYADA GERÇEK BİR DEĞER YOKTUR ve olmamalıdır.
#  Anahtar alanları bilinçli olarak BOŞ bırakılmıştır. Anahtarı olmayan
#  bir sağlayıcı "yapılandırılmamış" (NOT_CONFIGURED) sayılır: arayüzde
#  devre dışı görünür ve hiçbir ağ isteği yapılmaz. Yerel model ve yapay
#  zekâ gerektirmeyen tüm özellikler çalışmaya devam eder.
#
#  Anahtarı buraya YAZMAYIN; kopyaladığınız ".env" dosyasına ya da
#  işletim sisteminizin/kurumunuzun gizli değer yöneticisine girin.
#  Yer tutucu gerekiyorsa YOUR_PROVIDER_API_KEY_HERE yazın; gerçeğe
#  benzeyen sahte bir anahtar YAZMAYIN (tarayıcıları boş yere tetikler).
# ============================================================

# ------------------------------------------------------------
# 1) Django çekirdek ayarları
# ------------------------------------------------------------
# Üretimde mutlaka değiştirin. Üretmek için:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_TIME_ZONE=Europe/Istanbul
DJANGO_LANGUAGE_CODE=tr

# ------------------------------------------------------------
# 2) Veritabanı
#    sqlite  -> kurulum gerektirmez (varsayılan, demo için ideal)
#    postgres-> üretim önerisi (psycopg gerekir, bkz. requirements-optional.txt)
# ------------------------------------------------------------
DB_ENGINE=sqlite
DB_NAME=restaurant
DB_USER=restaurant
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ------------------------------------------------------------
# 3) İşletme bilgileri (fiş/rapor başlıklarında kullanılır)
# ------------------------------------------------------------
RESTAURANT_NAME=Akıllı Restaurant
RESTAURANT_CURRENCY=TRY
RESTAURANT_CURRENCY_SYMBOL=₺
RESTAURANT_DEFAULT_TAX_RATE=10.00
RESTAURANT_SERVICE_CHARGE_RATE=0.00

# ------------------------------------------------------------
# 4) Gerçek zamanlı katman (mutfak ekranı)
#    inmemory -> tek sunucu, kurulum gerektirmez (varsayılan)
#    redis    -> çok sunuculu dağıtım (channels-redis gerekir)
# ------------------------------------------------------------
CHANNEL_LAYER=inmemory
REDIS_URL=redis://127.0.0.1:6379/0

# ------------------------------------------------------------
# 5) Arka plan görevleri (isteğe bağlı)
#    False ise görevler istek içinde senkron çalışır.
# ------------------------------------------------------------
CELERY_ENABLED=False
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ============================================================
#  6) YAPAY ZEKÂ SAĞLAYICILARI
#     Hepsi isteğe bağlıdır. Anahtar girilmeyen sağlayıcı
#     otomatik olarak "yapılandırılmamış" sayılır ve arayüzde
#     devre dışı görünür.
# ============================================================

# Varsayılan yönlendirme politikası:
#   local_first  -> önce yerel model, başarısız olursa buluta düş (varsayılan)
#   local_only   -> yalnızca yerel model, internet gerekmez
#   cloud_first  -> önce bulut, başarısız olursa yerel
#   cloud_only   -> yalnızca bulut
AI_ROUTING_POLICY=local_first

# Gizlilik: müşteri adı/telefon/e-posta gibi verileri istem (prompt)
# içinde maskele. Bulut sağlayıcıya veri göndermeden önce şiddetle önerilir.
AI_MASK_PII=True

# Gizli veri içeren görevleri asla buluta gönderme
AI_SENSITIVE_LOCAL_ONLY=True

# İstek zaman aşımı (saniye) ve yeniden deneme
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2

# Bütçe kontrolü (USD). 0 = limitsiz.
AI_DAILY_BUDGET_USD=1.00
AI_MONTHLY_BUDGET_USD=20.00

# ------------------------------------------------------------
# 6.1) LM Studio (yerel, ücretsiz, internet gerektirmez)
#      LM Studio > Developer > Start Server ile başlatın.
# ------------------------------------------------------------
LMSTUDIO_ENABLED=True
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LM Studio yerel sunucusu anahtar istemez; alan boş kalabilir.
LMSTUDIO_API_KEY=
# Görev bazlı model eşlemesi (LM Studio /v1/models çıktısındaki id'ler)
LMSTUDIO_MODEL_GENERAL=google/gemma-4-12b-qat
LMSTUDIO_MODEL_REASONING=qwen/qwen3-vl-8b
LMSTUDIO_MODEL_CODE=qwen/qwen3-vl-8b
LMSTUDIO_MODEL_MATH=qwen2.5-math-7b-instruct
LMSTUDIO_MODEL_VISION=moondream-2b-2025-04-14
LMSTUDIO_MODEL_DOMAIN=biomistral-7b
LMSTUDIO_MODEL_EMBEDDING=text-embedding-nomic-embed-text-v1.5

# ------------------------------------------------------------
# 6.2) Ollama (yerel alternatif)
# ------------------------------------------------------------
OLLAMA_ENABLED=False
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL_GENERAL=llama3.1:8b

# ------------------------------------------------------------
# 6.3) NVIDIA NIM  (https://build.nvidia.com -> API Keys)
#      Anahtar biçimi: nvapi-...
# ------------------------------------------------------------
NVIDIA_ENABLED=False
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Aşağıdaki model kimlikleri build.nvidia.com kataloğundan doğrulanmıştır
# (Ağustos 2026) ve "Free Endpoint" ile kullanılabilir.
# Hepsi muhakeme (reasoning) modelidir; AI_MAX_TOKENS değerini düşürmeyin.
NVIDIA_MODEL_GENERAL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL_REASONING=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_MODEL_CODE=zai/glm-5.2
NVIDIA_MODEL_VISION=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_MODEL_EMBEDDING=nvidia/nemotron-3-embed-1b

# ------------------------------------------------------------
# 6.4) OpenAI uyumlu genel sağlayıcı
# ------------------------------------------------------------
OPENAI_ENABLED=False
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_GENERAL=gpt-4o-mini

# ------------------------------------------------------------
# 6.5) Anthropic Claude
# ------------------------------------------------------------
ANTHROPIC_ENABLED=False
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL_GENERAL=claude-sonnet-4-5

# ------------------------------------------------------------
# 6.6) Google Gemini
# ------------------------------------------------------------
GEMINI_ENABLED=False
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL_GENERAL=gemini-2.0-flash

# ------------------------------------------------------------
# 6.7) OpenRouter
# ------------------------------------------------------------
OPENROUTER_ENABLED=False
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_GENERAL=meta-llama/llama-3.3-70b-instruct

# ============================================================
#  7) AI GELİŞTİRME MERKEZİ / GÜVENLİ TERMİNAL
#     Üretimde ikisi de False olmalıdır.
# ============================================================
# GUVENLI VARSAYILAN: ikisi de KAPALI gelir. Yalnızca kendi geliştirme
# makinenizde ve bilinçli olarak açın; sunucuda/üretimde asla açmayın.
DEVCENTER_ENABLED=False
DEVCENTER_TERMINAL_ENABLED=False
# Terminalin çalışabileceği tek kök dizin. Dışına yazma engellenir.
# Boş bırakılırsa projenin kendi klasörü kullanılır.
DEVCENTER_ROOT=
DEVCENTER_COMMAND_TIMEOUT=180

# ------------------------------------------------------------
# 8) Güvenlik
# ------------------------------------------------------------
# Üretimde (DJANGO_DEBUG=False) HTTPS arkasında True yapın.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_TIMEOUT_MINUTES=480
# Başarısız giriş denemesi limiti ve kilit süresi (saat)
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1
# Anahtar şifreleme için Fernet anahtarı (veritabanında API anahtarı saklanacaksa).
# Üretmek için: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ------------------------------------------------------------
# 9) E-posta (rezervasyon hatırlatmaları vb. - isteğe bağlı)
# ------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@restaurant.local

# Yanıt başına azami token. Muhakeme (reasoning) yapan modeller
# (ör. gemma-4-12b-qat) yanıttan önce token harcadığı için düşük
# değerler boş yanıta yol açar. 2500 güvenli bir başlangıçtır.
AI_MAX_TOKENS=2500

# ------------------------------------------------------------
# 10) YEDEKLEME
# ------------------------------------------------------------
# Yedeklerin tutulacağı klasör. Boş bırakılırsa veri klasörünün
# altında "backups" kullanılır (paketlenmiş uygulamada exe'nin yanı).
#
# ÖNEMLİ: Aynı diskteki bir yedek, disk arızasına karşı koruma
# sağlamaz. Mümkünse ikinci bir diski veya ağ sürücüsünü gösterin.
BACKUP_DIR=

# Kaç yedek saklansın (elle + otomatik). 0 = sınırsız.
# Geri yükleme öncesi alınan güvenlik yedekleri bu sayıya dahil değildir.
BACKUP_KEEP_LAST=20

# Otomatik yedekleme: sunucu çalışırken belirtilen aralıkta yedek alır.
# Kapalıyken "python manage.py backup_now --if-due" komutunu Görev
# Zamanlayıcı ile çağırabilirsiniz.
BACKUP_SCHEDULE_ENABLED=False
BACKUP_SCHEDULE_HOURS=24

# .env dosyasının (API anahtarlarınızın) yedeğe eklenmesine izin ver.
# VARSAYILAN OLARAK KAPALI: yedek arşivi çoğu zaman e-posta veya bulut
# ile taşınır; anahtarların bu yolla sızması gerçek bir risktir.
BACKUP_ALLOW_SECRETS=False

# Medya klasörü bu sınırı (MB) aşarsa yedeğe eklenmez, uyarı verilir.
BACKUP_MEDIA_LIMIT_MB=512

# ============================================================
#  VERİ SAKLAMA SÜRELERİ (KVKK/GDPR — saklama sınırlaması)
# ============================================================
# Süreler GÜN cinsindendir; 0 = o kategori için otomatik temizleme KAPALI.
# Bu süreler işletmenizin ve veri sorumlunuzun (varsa DPO) kararıdır;
# uygulama bir süre dayatmaz. Temizleme kayıt SİLMEZ, yalnızca kişisel
# veri alanlarını boşaltır:
#   python manage.py purge_expired_logs          (önizleme)
#   python manage.py purge_expired_logs --apply  (uygula + kanıt kaydı)

# Denetim kayıtlarındaki IP adresi ve tarayıcı bilgisi
RETENTION_AUDIT_IP_DAYS=0

# Rıza kayıtlarındaki IP adresi (rıza kanıtının kendisi silinmez)
RETENTION_CONSENT_IP_DAYS=0

# Sonuçlanmış (tamamlandı/iptal/gelmedi) rezervasyonlarda misafir bilgisi
RETENTION_RESERVATION_GUEST_DAYS=0

# Kapanmış bekleme listesi kayıtlarında misafir bilgisi
RETENTION_WAITLIST_GUEST_DAYS=0

# ============================================================
#  BULUT AI SAĞLAYICI GOVERNANCE DOĞRULAMASI
# ============================================================
# Bulut sağlayıcı etkinleştirmeden önce resmî belgelerinden veri bölgesi,
# saklama ve eğitimde-kullanım şartlarını doğrulayın ve buraya işleyin.
# Doğrulanmadıkça sağlayıcı ayarları ekranında REVIEW_REQUIRED uyarısı
# görünür. Örnek (OpenAI için; NVIDIA/ANTHROPIC/GEMINI/OPENROUTER aynı
# desenle):
#   OPENAI_GOV_REGION=ABD (resmî belge + tarih)
#   OPENAI_GOV_TRAINING=API girdileri eğitimde kullanılmıyor (kaynak + tarih)
#   OPENAI_GOV_RETENTION=30 gün abuse izleme (kaynak + tarih)
#   OPENAI_GOV_REVIEWED=True
